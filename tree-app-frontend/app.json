{
  "expo": {
    "name": "Vriksha Netra",
    "slug": "vriksha-netra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vrikshanetra",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020906"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.aksharbharati.vrikshanetra",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#020906"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vriksha Netra to access your camera to identify and log trees."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Vriksha Netra to access your location to geotag planted trees."
        }
      ],
      "expo-web-browser"
    ]
  }
}
