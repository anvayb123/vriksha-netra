{
  "expo": {
    "name": "Tree Tracker",
    "slug": "tree-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vrikshanetra",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2d5a27"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.aksharbharati.treetracker",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2d5a27"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tree Tracker to access your camera to identify and log trees."
        }
      ],
      "expo-web-browser"
    ]
  }
}
