# ─── MongoDB Atlas ────────────────────────────────────────────────────────
# Get your connection string from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/vriksha-netra?retryWrites=true&w=majority

# ─── Authentication ──────────────────────────────────────────────────────
# Generate a random 64-char hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Cloudinary (Image storage) ──────────────────────────────────────────
# Get your keys from: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Plant.id API (kept ONLY on server — never in frontend!) ────────────
# Get your key from: https://web.plant.id/
PLANT_ID_API_KEY=your_plant_id_api_key

# ─── PlantNet API (Fallback / Higher Accuracy) ───────────────────────────
# Get your key from: https://my.plantnet.org/
PLANTNET_API_KEY=your_plantnet_api_key
